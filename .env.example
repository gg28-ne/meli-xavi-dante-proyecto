# F3: copia como .env. Completa las claves solo en tu copia privada.
APP_PORT=8085
DB_NAME=reservafacil
DB_USER=reservafacil
DB_PASSWORD=
DB_ROOT_PASSWORD=
# F5: modelo comprobado por el profesor; el alias puede cambiar en el proveedor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEBUG_CHAT=true
# F6: intervalo de práctica = 5 minutos.
BACKUP_INTERVAL_SECONDS=300
# F3: adapta esta URL al host real antes de configurar phpMyAdmin.
PMA_ABSOLUTE_URI=http://localhost:8085/phpmyadmin/
# La autenticación de Nginx se completará con un fichero .htpasswd.
